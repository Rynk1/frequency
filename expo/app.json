{
  "expo": {
    "name": "HarmonyFrequency: Your Spiritual Soundscape",
    "slug": "harmonyfrequency-your-spiritual-soundscape",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harmonyfrequency.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Harmony Frequency requires microphone access so you can record custom voice affirmations to play over healing soundscapes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.harmonyfrequency.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://harmonyfrequency.app/"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Harmony Frequency to record your voice for custom audio affirmations."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-notifications",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
