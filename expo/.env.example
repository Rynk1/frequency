# HARMONY FREQUENCY ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.

# ==========================================
# Client-Side Variables (Safe to expose in EXPO_PUBLIC_*)
# ==========================================

# Firebase Client SDK Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Cloud Functions Base URL
# Local Emulator: http://127.0.0.1:5001/your_project_id/us-central1
# Production:     https://us-central1-your_project_id.cloudfunctions.net
EXPO_PUBLIC_FUNCTIONS_URL=https://us-central1-your_project_id.cloudfunctions.net

# Application Deep Link / Web Redirect URL
EXPO_PUBLIC_APP_URL=https://harmonyfrequency.app

# ==========================================
# Server-Only Secrets (Firebase Functions Secrets Manager)
# DO NOT prefix with EXPO_PUBLIC_! DO NOT commit to Git!
# ==========================================
# STRIPE_SECRET_KEY=sk_test_... or sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# REVENUECAT_WEBHOOK_AUTH_HEADER=Bearer ...
# ADMIN_SECRET_KEY=a_secure_random_string_for_bootstrap
