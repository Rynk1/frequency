# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project details

# Get these values from your Firebase project settings
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Your existing API base URL (keep this)
EXPO_PUBLIC_RORK_API_BASE_URL=your_existing_api_url

# Stripe (subscriptions / billing)
# Server-only (Vercel env vars — NOT prefixed with EXPO_PUBLIC_):
#   STRIPE_SECRET_KEY        = sk_test_... or sk_live_...
#   STRIPE_WEBHOOK_SECRET    = whsec_...
#   STRIPE_PRICE_MONTHLY     = price_... (create in Stripe Dashboard → Products)
#   STRIPE_PRICE_YEARLY      = price_...
#   ADMIN_SECRET_KEY         = a long random string for first-admin bootstrap
#   FIREBASE_ADMIN_SERVICE_ACCOUNT_KEY = JSON service account key (single line)
#
# Client-side (safe to expose, prefixed with EXPO_PUBLIC_):
#   EXPO_PUBLIC_API_BASE_URL  = https://your-vercel-api.vercel.app
#   EXPO_PUBLIC_APP_URL       = https://your-app-url (for Stripe redirect URLs)
EXPO_PUBLIC_API_BASE_URL=https://your-vercel-api.vercel.app
EXPO_PUBLIC_APP_URL=https://your-app-url