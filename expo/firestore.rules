// ── Firestore Security Rules for HarmonyFrequency ──
// Deploy with: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.super_admin == true || request.auth.token.role == 'admin' || request.auth.token.role == 'super_admin');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Curated content: frequencies ──
    match /frequencies/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Curated content: curated programs ──
    match /curatedPrograms/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Curated content: articles ──
    match /articles/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── User profiles ──
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.subscriptionStatus == 'free'
        && !('subscriptionType' in request.resource.data || request.resource.data.subscriptionType == null)
        && !('subscriptionEndsAt' in request.resource.data || request.resource.data.subscriptionEndsAt == null)
        && !('trialEndsAt' in request.resource.data || request.resource.data.trialEndsAt == null)
        && !('stripeCustomerId' in request.resource.data)
        && !('stripeSubscriptionId' in request.resource.data)
        && !('cancelAtPeriodEnd' in request.resource.data)
        && !('role' in request.resource.data)
        && !('admin' in request.resource.data);

      allow update: if isOwner(userId)
        // Client cannot change subscription or admin role fields
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && (!('subscriptionType' in request.resource.data) || request.resource.data.subscriptionType == resource.data.subscriptionType)
        && (!('subscriptionEndsAt' in request.resource.data) || request.resource.data.subscriptionEndsAt == resource.data.subscriptionEndsAt)
        && (!('trialEndsAt' in request.resource.data) || request.resource.data.trialEndsAt == resource.data.trialEndsAt)
        && (!('stripeCustomerId' in request.resource.data) || request.resource.data.stripeCustomerId == resource.data.stripeCustomerId)
        && (!('stripeSubscriptionId' in request.resource.data) || request.resource.data.stripeSubscriptionId == resource.data.stripeSubscriptionId)
        && (!('cancelAtPeriodEnd' in request.resource.data) || request.resource.data.cancelAtPeriodEnd == resource.data.cancelAtPeriodEnd)
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        && (!('admin' in request.resource.data) || request.resource.data.admin == resource.data.admin);
    }

    // ── User sessions ──
    match /userSessions/{userId}/sessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }

    // ── User reminders ──
    match /userReminders/{userId}/reminders/{reminderId} {
      allow read, write: if isOwner(userId);
    }

    // ── User stats / progress ──
    match /userStats/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── User achievements ──
    match /userAchievements/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Immutable listening events
    match /userUsage/{userId}/events/{eventId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.id == eventId
        && request.resource.data.durationMinutes is number
        && request.resource.data.date is string;
      allow update, delete: if false;
    }

    // ── User frequency library ──
    match /userFavorites/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Subscription Events (Idempotency) ──
    match /subscriptionEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // Only written by Cloud Functions
    }

    // ── Audit logs (admin-only) ──
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Append-only, written server-side
    }

    // ── Default deny ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
