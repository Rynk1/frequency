// ── Firestore Security Rules for HarmonyFrequency ──
// Deploy with: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.super_admin == true || request.auth.token.role == 'admin' || request.auth.token.role == 'super_admin');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Returns true if a field is not present in request OR equals existing resource field value OR neither request nor resource has it
    function isFieldUnchanged(field) {
      return !(field in request.resource.data) ||
        (resource != null && resource.data != null && field in resource.data && request.resource.data[field] == resource.data[field]) ||
        (resource != null && resource.data != null && !(field in resource.data) && !(field in request.resource.data));
    }

    // ── Curated content: frequencies ──
    match /frequencies/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Curated content: curated programs ──
    match /curatedPrograms/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Curated content: articles ──
    match /articles/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Subscriptions & Entitlements (Server Authoritative) ──
    match /subscriptions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Cloud Functions admin SDK only
    }

    match /entitlements/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Cloud Functions admin SDK only
    }

    // ── User profiles ──
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Initial profile document creation (or setDoc merge on non-existent document)
      allow create: if isOwner(userId)
        && (!('subscriptionStatus' in request.resource.data) || request.resource.data.subscriptionStatus == 'free')
        && (!('subscriptionType' in request.resource.data) || request.resource.data.subscriptionType == null)
        && (!('subscriptionEndsAt' in request.resource.data) || request.resource.data.subscriptionEndsAt == null)
        && (!('trialEndsAt' in request.resource.data) || request.resource.data.trialEndsAt == null)
        && (!('cancelAtPeriodEnd' in request.resource.data) || request.resource.data.cancelAtPeriodEnd == false || request.resource.data.cancelAtPeriodEnd == null)
        && (!('role' in request.resource.data) || request.resource.data.role == null)
        && (!('admin' in request.resource.data) || request.resource.data.admin == false || request.resource.data.admin == null);

      // Client updates on existing documents: Client can update user-owned fields (displayName, onboardingCompleted, onboardingPreferences, usageStats, etc.)
      // Client CANNOT change or introduce server-authoritative fields (subscriptionStatus, subscriptionType, subscriptionEndsAt, trialEndsAt, cancelAtPeriodEnd, role, admin)
      allow update: if isOwner(userId)
        && isFieldUnchanged('subscriptionStatus')
        && isFieldUnchanged('subscriptionType')
        && isFieldUnchanged('subscriptionEndsAt')
        && isFieldUnchanged('trialEndsAt')
        && isFieldUnchanged('cancelAtPeriodEnd')
        && isFieldUnchanged('role')
        && isFieldUnchanged('admin');
    }

    // ── User sessions ──
    match /userSessions/{userId}/sessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }

    // ── User reminders ──
    match /userReminders/{userId}/reminders/{reminderId} {
      allow read, write: if isOwner(userId);
    }

    // ── User stats / progress ──
    match /userStats/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── User achievements ──
    match /userAchievements/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── User learning progress ──
    match /userLearning/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Immutable listening events
    match /userUsage/{userId}/events/{eventId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.id == eventId
        && request.resource.data.durationMinutes is number
        && request.resource.data.date is string;
      allow update, delete: if false;
    }

    // ── User frequency library ──
    match /userFavorites/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Subscription Events (Idempotency Ledger) ──
    match /subscriptionEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // Only written by Cloud Functions
    }

    // ── Audit logs (admin-only) ──
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Append-only, written server-side
    }

    // ── Default deny ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
